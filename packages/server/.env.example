# Server Configuration
PORT=3000

# CORS Configuration
# For development: allow all origins (default if not set)
# For production: comma-separated list of allowed origins
# Examples:
#   Single origin: CORS_ORIGINS=https://your-frontend.com
#   Multiple origins: CORS_ORIGINS=https://app.com,https://www.app.com
CORS_ORIGINS=*

# Environment
NODE_ENV=production
